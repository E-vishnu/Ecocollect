PORT=5000
NODE_ENV=development

# MongoDB Connection String (Placeholder only - specify your local or Atlas URI in .env)
MONGODB_URI=mongodb://127.0.0.1:27017/ecocollect

# JWT Authentication Secret (Use a strong random secret with at least 32 characters in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Classifier Microservice URL (FastAPI / PyTorch MobileNet inference service)
CLASSIFIER_SERVICE_URL=http://localhost:8000/classify

# Razorpay / Payment Gateway Sandbox Credentials (Placeholders only)
RAZORPAY_KEY_ID=your_razorpay_key_id_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_placeholder
UPI_MERCHANT_VPA=ecocollect.municipal@okaxis

# IoT Hardware Security (Optional: shared secret expected in X-Device-Key header)
IOT_DEVICE_KEY=your_esp32_device_shared_api_key_placeholder
